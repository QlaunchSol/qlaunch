# ── Public: inlined into the bundle at BUILD time; rebuild after changing ─────
NEXT_PUBLIC_SITE_NAME=Hashmint                    # placeholder brand
NEXT_PUBLIC_SITE_URL=https://2-29-22-94.sslip.io  # canonical URL, no trailing slash
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet                # mainnet | devnet
NEXT_PUBLIC_PROJECT_ID=                           # Reown (WalletConnect) project id: dashboard.reown.com
NEXT_PUBLIC_SUPABASE_URL=                         # same as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                    # anon key: read-only under RLS, used for the live feed
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_GITHUB_URL=

# ── Server only ───────────────────────────────────────────────────────────────
HELIUS_RPC_URL=                                   # https://mainnet.helius-rpc.com/?api-key=…  (falls back to the public RPC)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                        # never expose: bypasses RLS
PINATA_JWT=
PINATA_GATEWAY=                                   # e.g. your-gateway.mypinata.cloud
TREASURY_ADDRESS=                                 # on-chain creator of every coin: receives pump.fun creator fees
LOOKUP_TABLE_ADDRESS=                             # address lookup table for dev-buy launches: scripts/create-lookup-table.mts
BIRDEYE_API_KEY=                                  # optional: holder counts and chart fallback
REDIS_URL=redis://127.0.0.1:6379                  # optional: falls back to in-process cache
