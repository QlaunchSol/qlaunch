# ── Public: inlined into the bundle at BUILD time; rebuild after changing ─────
NEXT_PUBLIC_SITE_NAME=Qlaunch
NEXT_PUBLIC_SITE_URL=https://qlaunch.xyz          # canonical URL, no trailing slash
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet                # mainnet | devnet
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_GITHUB_URL=

# ── Server only: read at runtime; restart after changing ─────────────────────
DATABASE_URL=                                     # local PostgreSQL: deploy/postgres.sh prints it
HELIUS_RPC_URL=                                   # any Solana RPC; Helius also enables holder counts (falls back to the public RPC)
PINATA_JWT=                                       # IPFS pinning for coin images and metadata
PINATA_GATEWAY=                                   # e.g. your-gateway.mypinata.cloud
LOOKUP_TABLE_ADDRESS=                             # address lookup table for dev-buy launches: scripts/create-lookup-table.mts
REDIS_URL=redis://127.0.0.1:6379                  # optional: falls back to an in-process cache
IP_HASH_SALT=                                     # random secret: visitor IPs are stored only as salted hashes (reports, upload caps)
UPLOADS_PER_DAY=300                               # global daily cap on image uploads (protects the IPFS plan)
CSP_ENFORCE_SCRIPTS=0                             # 1 = enforce the strict script/connect CSP (report-only until real wallets are confirmed)
